{
  "name": "demo-studio-pilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs dev --host 127.0.0.1 --port 4321",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "check": "astro check",
    "qa": "node scripts/qa.mjs",
    "start": "node --env-file-if-exists=.env dist/server/entry.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "test:booking": "node scripts/test-booking.mjs",
    "start:review": "node --env-file-if-exists=.env scripts/review-server.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/node": "11.1.9",
    "@fontsource/archivo": "5.3.0",
    "@fontsource/bodoni-moda": "5.3.0",
    "astro": "7.3.8",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@types/node": "22.20.5",
    "playwright-core": "1.64.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "unifont": "0.7.4"
  }
}
